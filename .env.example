# Directory that contains all component repos (siblings of money-machine-core)
MM_ROOT=..
# Shared state directory for all components (absolute or relative to money-machine-core)
MM_STATE_DIR=.mm-state
# Seconds between supervisor cycles
MM_CYCLE_INTERVAL_MS=300000
# Max runtime per component cycle
MM_STEP_TIMEOUT_MS=120000
# Dashboard
MM_DASHBOARD_PORT=8780
MM_DASHBOARD_HOST=127.0.0.1
# Required for kill/resume via the dashboard HTTP API
MM_ADMIN_TOKEN=
# Optional operator alerts (component failures, kill switch, live mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
