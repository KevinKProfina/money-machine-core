# Shared Money Machine state directory (strategy report, ledger, events, KILL)
MM_STATE_DIR=.mm-state

# paper (default, simulated fills) | dry-run (decisions only) | live (refused: not implemented)
MODE=paper
# Required for live mode in the system contract; live mode is still refused here.
LIVE_TRADING_CONFIRM=

# Opportunity source: simulated (only implemented source) | kamino | marginfi | save | aave-v3 (stubs, refused)
OPPORTUNITY_SOURCE=simulated
SIM_SEED=42
SIM_POSITIONS_PER_CYCLE=12

# Capital used when the orchestrator has not written allocations.json yet
STARTING_CAPITAL_USD=1000

# Deterministic gates
MIN_LIQUIDATION_PROFIT_USD=10
MAX_LIQUIDATION_SIZE_USD=200
MAX_GAS_SHARE=0.3
MAX_RISK_SCORE=60
MAX_EXECUTIONS_PER_CYCLE=3

# Cost model
COLLATERAL_SLIPPAGE_BPS=30
USE_FLASH_LOAN=false
FLASH_LOAN_FEE_BPS=5

# Paper executor realism knobs (calibrated so ~50 cycles are roughly break-even)
# pWin = PAPER_BASE_WIN_PROBABILITY / (1 + netProfit/COMPETITION_REF_USD + repay/COMPETITION_SIZE_REF_USD)
PAPER_BASE_WIN_PROBABILITY=0.4
COMPETITION_REF_USD=50
COMPETITION_SIZE_REF_USD=20000
PAPER_TX_FAILURE_PROBABILITY=0.1
PAPER_REVERT_GAS_FRACTION=0.3
PAPER_MAX_GAS_SPIKE_MULTIPLIER=2
PAPER_MAX_ADVERSE_SLIPPAGE_BPS=150
PAPER_PRICE_MOVE_HORIZON_SEC=900
PAPER_ADVERSE_SELECTION_FRACTION=0.55
PAPER_TAIL_LOSS_PROBABILITY=0.05
PAPER_TAIL_LOSS_MIN=0.05
PAPER_TAIL_LOSS_MAX=0.3

# Loop interval (ms) when not using --once
LIQUIDATION_INTERVAL_MS=60000

# Optional Claude review gate (skipped when empty); set CLAUDE_GATE=off to disable with a key present
ANTHROPIC_API_KEY=
CLAUDE_GATE=on

# Optional Telegram alerts (skipped when empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
