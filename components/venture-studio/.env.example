# --- Money Machine integration ---
# Shared state directory (events.jsonl, KILL, allocations.json, studio/). Default ./.mm-state
MM_STATE_DIR=./.mm-state

# --- Mode ---
# paper (default) | dry-run | live. Only affects a LIVE Stripe key: sk_live_/rk_live_ keys are used
# only with MODE=live AND LIVE_TRADING_CONFIRM=I_UNDERSTAND_REAL_MONEY_RISK. Test keys work in any mode.
# The per-venture owner approval gate applies in EVERY mode and cannot be switched off.
MODE=paper
LIVE_TRADING_CONFIRM=

# --- Loop ---
STUDIO_INTERVAL_MS=3600000

# --- Pipeline ---
# Ideation runs while idea+queued+review+ready+approved+live ventures < STUDIO_MAX_ACTIVE
STUDIO_MAX_ACTIVE=5
STUDIO_IDEAS_PER_DAY=3
# final score = (1-w)*critic + w*autonomy*100; keep >= STUDIO_MIN_SCORE and critic >= STUDIO_MIN_CRITIC
STUDIO_AUTONOMY_WEIGHT=0.4
STUDIO_MIN_SCORE=60
STUDIO_MIN_CRITIC=45
# Minimum length (chars) of a digital product's Markdown
STUDIO_MIN_PRODUCT_CHARS=4000
# Days a venture is purchasable before evaluation: 0 sales -> killed, >= STUDIO_WINNER_SALES -> winner
STUDIO_EVAL_DAYS=21
STUDIO_WINNER_SALES=3

# --- Publishing (only after owner approval) ---
# Public base URL of the static site (canonical URLs, sitemap, Stripe redirect)
STUDIO_SITE_URL=
# Required for the Impressum (German Impressumspflicht). Missing -> ventures are blocked before publish.
STUDIO_OPERATOR_NAME=
STUDIO_OPERATOR_ADDRESS=
STUDIO_OPERATOR_EMAIL=
# Shell command run in $MM_STATE_DIR/studio/site after each site change, e.g.
#   rsync -a --delete ./ user@host:/var/www/shop/    or    npx wrangler pages deploy . --project-name shop
STUDIO_DEPLOY_CMD=
STUDIO_DEPLOY_TIMEOUT_MS=120000
# Shown under the price on landing pages (check your VAT situation, e.g. Kleinunternehmer § 19 UStG)
STUDIO_PRICE_NOTE=Endpreis / final price
STUDIO_CURRENCY=eur

# --- Sales channel ---
# Empty -> channel "none" (pages say "coming soon", nothing can be sold). sk_test_ -> simulated sales.
STRIPE_API_KEY=

# --- Claude (optional; without it: offline seed catalog + regex-only review) ---
ANTHROPIC_API_KEY=
STUDIO_LLM_DAILY_BUDGET_USD=3
STUDIO_LLM_INPUT_USD_PER_MTOK=4
STUDIO_LLM_OUTPUT_USD_PER_MTOK=20
