# Shared Money Machine state directory (marketplace.json is written here;
# private state lives in $MM_STATE_DIR/agent-marketplace/state.json)
MM_STATE_DIR=./.mm-state

# HTTP daemon
PORT=8790
HOST=127.0.0.1

# Admin bearer token for POST /deposits (internal credits). Unset = deposits disabled.
ADMIN_TOKEN=

# Platform fee (revenue share) taken from every completed paid job, percent 0..100
PLATFORM_FEE_PCT=10

# Comma-separated hosts allowed as webhook targets (exact host or *.suffix). Empty = no webhooks.
WEBHOOK_ALLOWLIST=
# Dev/test only: allow http:// and private/loopback webhook targets. Never enable in production.
WEBHOOK_ALLOW_PRIVATE=0
WEBHOOK_TIMEOUT_MS=10000

# Optional: enables Claude for the builtin `summarize` service (fallback: extractive summary)
ANTHROPIC_API_KEY=

# How often the daemon re-writes marketplace.json and drains the job queue (ms)
REPORT_INTERVAL_MS=60000
# Max JSON request body size (bytes)
MAX_BODY_BYTES=65536
