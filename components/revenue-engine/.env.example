# Shared Money Machine state directory (default ./.mm-state)
MM_STATE_DIR=./.mm-state

# Loop interval in ms (loop mode only; `--once` runs a single cycle)
REVENUE_INTERVAL_MS=300000
# Comma-separated adapters to run (default: trading,ai-services,inbox,stripe,gumroad).
# stripe/gumroad are only active when their secrets below are set.
REVENUE_SOURCES=trading,ai-services,inbox,stripe,gumroad
# How far back API adapters look on their first run (days)
REVENUE_BACKFILL_DAYS=30

# Marketplace revenue is labeled simulated unless set to false (only do that once payments are real and verified)
MARKETPLACE_REVENUE_SIMULATED=true

# Optional: Stripe (balance transactions). Use a restricted read-only key. sk_test_/rk_test_ keys => events labeled simulated.
STRIPE_API_KEY=
# Kind for Stripe revenue: trading|liquidation|ai-services|affiliate|digital-products|saas|other
STRIPE_STREAM_KIND=saas
STRIPE_STREAM_NAME=stripe

# Optional: Gumroad sales (digital-products)
GUMROAD_ACCESS_TOKEN=
GUMROAD_STREAM_NAME=gumroad

# HTTP behaviour for external APIs
REVENUE_HTTP_TIMEOUT_MS=15000
REVENUE_HTTP_RETRIES=3
REVENUE_HTTP_BACKOFF_MS=500
