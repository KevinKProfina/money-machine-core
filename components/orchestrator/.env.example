# Shared Money Machine state directory
MM_STATE_DIR=.mm-state

# Base capital (USD). Total capital = TOTAL_CAPITAL + reinvested profits - unrecovered realized losses.
TOTAL_CAPITAL=1000
# conservative | moderate | aggressive (validated; should match capital-allocator)
RISK_PROFILE=moderate

# Fractions accept 0..1 or a percentage (e.g. 10 = 0.10)
# Portfolio drawdown from the equity high-water mark that trips the (latched) kill switch
MAX_PORTFOLIO_DRAWDOWN=0.25
# Max share of total capital per strategy
MAX_STRATEGY_EXPOSURE=0.5
# Share of total capital always kept unallocated
RESERVE_PCT=0.1
# Max change per strategy per cycle, as a share of total capital (pauses go to 0 immediately)
MAX_REBALANCE_STEP_PCT=0.1
# Share of positive realized profit added to total capital (rest is retained)
REINVESTMENT_PERCENT=0.5
# Strategy drawdown where exposure starts shrinking / where the strategy is paused
STRATEGY_DRAWDOWN_REDUCE=0.15
STRATEGY_DRAWDOWN_PAUSE=0.35

# Health gate (0..100) and report staleness
MIN_HEALTH_SCORE=50
STALE_REPORT_MS=21600000

# Loop mode interval
POLL_INTERVAL_MS=300000
