# --- Money Machine integration ---
# Shared state directory (strategies/, allocations.json, KILL, events.jsonl). Default ./.mm-state
MM_STATE_DIR=./.mm-state

# --- Mode (safe by default) ---
# paper (default) | dry-run | live
MODE=paper
# Live trading additionally requires this exact phrase (and SOLANA_PRIVATE_KEY):
LIVE_TRADING_CONFIRM=
# Legacy flag: DRY_RUN=true selects dry-run when MODE is unset
DRY_RUN=
POLL_INTERVAL_MS=300000
MAX_CANDIDATES=30

# --- Capital / sizing ---
# Budget used until the orchestrator writes allocations.json
STARTING_CAPITAL_USD=1000
MAX_USD_PER_TRADE=50
# Fraction of budget per position (0.1 = 10 %)
MAX_POSITION_PCT=0.1
MAX_CONCURRENT_POSITIONS=5
MIN_TRADE_USD=5

# --- Entry gates / scoring ---
MIN_LIQUIDITY_USD=50000
MIN_VOLUME_24H_USD=100000
MIN_MARKET_CAP_USD=250000
MAX_MARKET_CAP_USD=500000000
MIN_AGE_HOURS=24
MIN_TXNS_24H=200
MIN_BUY_SELL_RATIO=0.9
MIN_LIQUIDITY_TO_MCAP=0.03
MIN_SCORE=50

# Optional extra gates (unset = off, today's behaviour)
# MAX_AGE_HOURS=
# Momentum gates on DexScreener priceChange (%), skipped when the field is absent
# MIN_CHANGE_M5=
# MIN_CHANGE_H1=
# MAX_CHANGE_H1=
# MIN_CHANGE_H24=
# Candidate order: score (default) | h1-momentum | turnover | buy-pressure | youngest
RANK_BY=score
# No new entries for this many hours after any close (0 = off)
ENTRY_COOLDOWN_HOURS=0

# --- Strategy source ---
# static (default): the env values in this file.
# arena: each cycle read $MM_STATE_DIR/arena/promotions.json (written by agent-arena) and use
#        the promoted genome's mapped settings; falls back to static when missing/invalid.
#        This NEVER changes the mode: live still requires MODE=live + LIVE_TRADING_CONFIRM.
STRATEGY_SOURCE=static

# --- Exits ---
TAKE_PROFIT_PCT=25
STOP_LOSS_PCT=10
TRAILING_STOP_PCT=8
TRAILING_ACTIVATION_PCT=5
MAX_HOLD_HOURS=48
# Close all open positions automatically while the kill switch is active
KILL_CLOSES_POSITIONS=false

# --- Paper execution model ---
PAPER_SLIPPAGE_BPS=100
PAPER_FEE_BPS=30

# --- Optional Claude gate (skipped when no key) ---
ANTHROPIC_API_KEY=
USE_CLAUDE_GATE=true

# --- Live only ---
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
LIVE_SLIPPAGE_BPS=100
MIN_SOL_BALANCE=0.05

# --- Optional alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
