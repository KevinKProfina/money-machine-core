# --- Money Machine integration ---
# Shared state dir. Daily aggregates go to $MM_STATE_DIR/analytics/<site>/<yyyy-mm-dd>.json.
# Use the SAME dir as venture-studio so the studio reads the files directly (no token needed).
MM_STATE_DIR=./.mm-state

# --- HTTP ---
PORT=8791
HOST=127.0.0.1
# Comma-separated exact origins allowed to send beacons (CORS). Empty → every beacon is refused.
ANALYTICS_ALLOWED_ORIGINS=https://shop.example.com
# Optional allow-list of site ids (default: any well-formed id). The studio uses the hostname of STUDIO_SITE_URL.
ANALYTICS_SITES=
# Only behind YOUR reverse proxy: take the client IP from the first X-Forwarded-For entry
# (needed for bot/rate-limit/unique estimation; the IP is never stored).
ANALYTICS_TRUST_PROXY=0

# --- Reading stats ---
# Bearer token for GET /stats (>= 16 chars). Empty → /stats disabled. Set the same value in venture-studio
# only if the studio does not share MM_STATE_DIR with the collector.
ANALYTICS_READ_TOKEN=

# --- Storage / limits ---
ANALYTICS_RETENTION_DAYS=400
ANALYTICS_FLUSH_INTERVAL_MS=60000
ANALYTICS_RATE_LIMIT_PER_MIN=60
ANALYTICS_MAX_PATHS_PER_DAY=500
ANALYTICS_MAX_REFERRERS_PER_DAY=200
