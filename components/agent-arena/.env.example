# --- Money Machine integration ---
# Shared state directory (strategies/, allocations.json, KILL, events.jsonl, arena/). Default ./.mm-state
MM_STATE_DIR=./.mm-state

# --- Mode ---
# agent-arena is PAPER ONLY. MODE=live is refused at startup. MODE=dry-run behaves like paper.
MODE=paper

# --- Market data ---
# dexscreener (default, real public market data) | synthetic (seeded random walk, demos/tests only)
ARENA_MARKET=dexscreener
# Seed for agent RNG + synthetic market. Empty = random at genesis (then persisted in population.json)
ARENA_SEED=
ARENA_SYNTHETIC_TOKENS=40
# Loop interval for `npm start` (one cycle per interval)
ARENA_INTERVAL_MS=300000

# --- Economics / lifecycle ---
# Arena capital until the orchestrator writes allocations.json; afterwards equity follows the budget
ARENA_STARTING_CAPITAL_USD=500
# Birth capital of agents spawned from the treasury
ARENA_SEED_USD=5
ARENA_MIN_POPULATION=20
ARENA_MAX_POPULATION=2000
# Random immigrants per cycle (exploration), only while treasury > reserve pct of equity
ARENA_IMMIGRANTS_PER_CYCLE=1
ARENA_TREASURY_RESERVE_PCT=0.2
ARENA_MAX_SPAWNS_PER_CYCLE=20
# Per agent per cycle. Models compute cost of a tiny rule-based agent; LLM-driven agents cost far more.
ARENA_UPKEEP_USD=0.002
ARENA_DEATH_USD=0.5
ARENA_REPRO_MULTIPLE=2
ARENA_REPRO_MIN_AGE=12
ARENA_REPRO_SHARE=0.5
ARENA_MUTATION_RATE=0.2
ARENA_CROSSOVER_RATE=0.15

# --- Paper fills ---
ARENA_FEE_BPS=30
ARENA_SLIPPAGE_BPS=100
ARENA_MIN_TRADE_USD=0.25
ARENA_STALE_WRITE_OFF_CYCLES=288

# --- Optional Claude mutator (skipped when ANTHROPIC_API_KEY is empty) ---
ANTHROPIC_API_KEY=
ARENA_LLM_EVERY=50
ARENA_LLM_GENOMES=5
ARENA_LLM_DAILY_BUDGET_USD=1
ARENA_LLM_INPUT_USD_PER_MTOK=4
ARENA_LLM_OUTPUT_USD_PER_MTOK=20

# Print every paper trade (noisy with large populations)
ARENA_VERBOSE=0
