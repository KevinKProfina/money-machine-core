# Shared Money Machine state directory (strategies/*.json in, allocation-proposal.json out)
MM_STATE_DIR=.mm-state

# Capital the proposal is computed against (USD). The orchestrator rescales by share.
TOTAL_CAPITAL=1000
# conservative | moderate | aggressive (anything else is a fatal config error)
RISK_PROFILE=moderate
# Minimum USD for every strategy that passes the risk gate
MIN_STRATEGY_CAPITAL=10
# Per-strategy cap as a fraction of TOTAL_CAPITAL (default depends on RISK_PROFILE: 0.35/0.5/0.7)
MAX_STRATEGY_SHARE=
# Fraction of capital for strategies with fewer than MIN_TRADES_FOR_CONFIDENCE trades (0 = disabled, max 0.5)
EXPLORATION_SHARE=0
MIN_TRADES_FOR_CONFIDENCE=10
# Strength of the neutral prior in pseudo-trades: confidence = trades / (trades + PRIOR_TRADES)
PRIOR_TRADES=20
# Loop mode interval
ALLOCATION_INTERVAL_MS=3600000
# Score multiplier for strategies whose report notes contain "synthetic-market-data" (0..1).
# They are also capped at EXPLORATION_SHARE of capital (10 % when EXPLORATION_SHARE=0).
SYNTHETIC_DATA_WEIGHT=0.25
