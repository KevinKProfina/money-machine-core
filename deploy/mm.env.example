# Copy to deploy/mm.env. One file for the whole system; every component reads what it needs.
# All strategies run in PAPER mode unless MODE=live AND LIVE_TRADING_CONFIRM are set — leave them unset.

# --- supervisor / dashboard ---
MM_CYCLE_INTERVAL_MS=300000
MM_ADMIN_TOKEN=change-me-to-a-long-random-string
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- capital ---
TOTAL_CAPITAL=1000
RISK_PROFILE=moderate

# --- optional Claude gates / mutator ---
ANTHROPIC_API_KEY=

# --- agent-marketplace ---
ADMIN_TOKEN=change-me-too
PLATFORM_FEE_PCT=10

# --- agent-arena ---
ARENA_MARKET=dexscreener

# --- revenue-engine (optional) ---
STRIPE_API_KEY=
GUMROAD_ACCESS_TOKEN=
